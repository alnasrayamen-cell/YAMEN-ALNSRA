/* =========================================================
   EDIT PRODUCT
========================================================= */

function editProduct(id){

    const p=products.find(x=>x.id===id);

    if(!p) return;

    document.getElementById("editProductId").value=p.id;

    document.getElementById("newName").value=p.name;

    document.getElementById("newCategory").value=p.category;

    document.getElementById("newPrice").value=p.price;

    document.getElementById("newStock").value=p.stock;

    document.getElementById("newColor1").value=p.colors[0];

    document.getElementById("newColor2").value=p.colors[1];

    document.getElementById("newImage").value=p.image;

    document.getElementById("newDescription").value=p.description;

    document.getElementById("formTitle").textContent=
        "تعديل المنتج #"+p.id;

    showAdminSectionById("addProduct");

}

function saveProduct(){

    const id=Number(document.getElementById("editProductId").value);

    const name=document.getElementById("newName").value.trim();

    const category=document.getElementById("newCategory").value;

    const price=Number(document.getElementById("newPrice").value);

    const stock=Number(document.getElementById("newStock").value);

    const color1=document.getElementById("newColor1").value;

    const color2=document.getElementById("newColor2").value;

    const image=document.getElementById("newImage").value.trim();

    const description=document.getElementById("newDescription").value.trim();

    if(!name || !price){

        toast("أدخل اسم المنتج والسعر");

        return;
    }

    if(id){

        const p=products.find(x=>x.id===id);

        if(p){

            p.name=name;
            p.category=category;
            p.price=price;
            p.stock=Math.max(0,stock);
            p.colors=[color1,color2];
            p.image=image || imagePool[p.id%imagePool.length];
            p.description=description;

        }

        toast("تم تعديل المنتج ✅");

    }else{

        const newId=
            products.length ?
            Math.max(...products.map(p=>p.id))+1 :
            1;

        products.push({

            id:newId,
            name:name,
            category:category,
            price:price,
            stock:Math.max(0,stock),
            colors:[color1,color2],
            image:image || imagePool[newId%imagePool.length],
            description:description || "إكسسوار رجالي أنيق من yamennasra.",
            barcode:"629"+String(100000000+newId).slice(-9)

        });

        toast("تمت إضافة المنتج ✅");

    }

    saveProducts();

    resetProductForm();

    renderProducts();
    updateAdmin();
    renderAdminProducts();

}

function resetProductForm(){

    document.getElementById("editProductId").value="";

    document.getElementById("formTitle").textContent=
        "إضافة منتج جديد";

    document.getElementById("newName").value="";
    document.getElementById("newPrice").value="99";
    document.getElementById("newStock").value="10";
    document.getElementById("newColor1").value="#111111";
    document.getElementById("newColor2").value="#c9a227";
    document.getElementById("newImage").value="";
    document.getElementById("newDescription").value="";

}

function deleteProduct(id){

    const p=products.find(x=>x.id===id);

    if(!p) return;

    if(!confirm("هل تريد حذف "+p.name+"؟")){
        return;
    }

    products=products.filter(x=>x.id!==id);

    cart=cart.filter(x=>x.id!==id);

    saveProducts();
    saveCart();

    renderProducts();
    renderCart();
    renderAdminProducts();
    updateAdmin();

    toast("تم حذف المنتج");

}


/* =========================================================
   STOCK
========================================================= */

function renderStock(){

    const table=document.getElementById("stockTable");

    table.innerHTML=products.map(p=>`

        <tr>

            <td>${p.name}</td>

            <td>${p.barcode}</td>

            <td>
                <input
                    type="number"
                    min="0"
                    value="${p.stock}"
                    style="width:90px;padding:8px;border:1px solid #ddd;border-radius:7px;"
                    onchange="changeStock(${p.id},this.value)">
            </td>

            <td>
                ${
                    p.stock<=0
                    ? '<span style="color:#dc2626;">نفد</span>'
                    : p.stock<=5
                    ? '<span style="color:#d97706;">منخفض</span>'
                    : '<span style="color:#16a34a;">جيد</span>'
                }
            </td>

            <td>
                <button class="small-btn edit"
                    onclick="editProduct(${p.id})">
                    تعديل
                </button>
            </td>

        </tr>

    `).join("");

}

function changeStock(id,value){

    const p=products.find(x=>x.id===id);

    if(!p) return;

    p.stock=Math.max(0,Number(value)||0);

    saveProducts();

    renderProducts();
    updateAdmin();

    toast("تم تحديث المخزون");

}


/* =========================================================
   BARCODE
========================================================= */

function renderBarcodes(){

    const area=document.getElementById("barcodePrintArea");

    area.innerHTML=products.map(p=>`

        <div class="barcode-label">

            <strong>${p.name}</strong>

            <svg
                id="barcode-${p.id}">
            </svg>

            <div style="font-size:12px;margin-top:5px;">
                ${p.barcode}
            </div>

        </div>

    `).join("");

    products.forEach(p=>{

        try{

            JsBarcode(
                "#barcode-"+p.id,
                p.barcode,
                {
                    format:"CODE128",
                    width:1.7,
                    height:50,
                    displayValue:false,
                    margin:0
                }
            );

        }catch(e){}

    });

}

function printBarcodes(){

    renderBarcodes();

    setTimeout(()=>{
        window.print();
    },300);

}


/* =========================================================
   ORDERS
========================================================= */

function renderOrders(){

    const table=document.getElementById("ordersTable");

    if(orders.length===0){

        table.innerHTML=`
            <tr>
                <td colspan="7" style="text-align:center;padding:40px;">
                    لا توجد طلبات حتى الآن.
                </td>
            </tr>
        `;

        return;
    }

    table.innerHTML=orders.map(o=>`

        <tr>

            <td>${o.id}</td>

            <td>${o.customer}</td>

            <td>${o.phone}</td>

            <td>${o.city}</td>

            <td>${money(o.total)}</td>

            <td>${o.date}</td>

            <td>

                <select
                    onchange="changeOrderStatus('${o.id}',this.value)"
                    style="padding:7px;border:1px solid #ddd;border-radius:7px;">

                    ${[
                        "جديد",
                        "قيد التجهيز",
                        "تم الشحن",
                        "تم التسليم",
                        "ملغي"
                    ].map(s=>`
                        <option ${o.status===s?"selected":""}>
                            ${s}
                        </option>
                    `).join("")}

                </select>

            </td>

        </tr>

    `).join("");

}

function changeOrderStatus(id,status){

    const o=orders.find(x=>x.id===id);

    if(o){

        o.status=status;

        saveOrders();

        updateAdmin();

        toast("تم تحديث حالة الطلب");

    }

}


/* =========================================================
   DELIVERY
========================================================= */

function saveDelivery(){

    const data={

        name:document.getElementById("deliveryName").value,

        api:document.getElementById("deliveryApi").value,

        key:document.getElementById("deliveryKey").value,

        merchant:document.getElementById("merchantId").value

    };

    localStorage.setItem(
        STORAGE_DELIVERY,
        JSON.stringify(data)
    );

    toast("تم حفظ إعدادات التوصيل 🚚");

}

function loadDelivery(){

    const data=
        JSON.parse(localStorage.getItem(STORAGE_DELIVERY)||"{}");

    document.getElementById("deliveryName").value=
        data.name||"";

    document.getElementById("deliveryApi").value=
        data.api||"";

    document.getElementById("deliveryKey").value=
        data.key||"";

    document.getElementById("merchantId").value=
        data.merchant||"";

}


/* =========================================================
   SETTINGS
========================================================= */

function saveSettings(){

    const data={

        name:document.getElementById("storeName").value,

        description:
            document.getElementById("storeDescription").value

    };

    localStorage.setItem(
        STORAGE_SETTINGS,
        JSON.stringify(data)
    );

    document.querySelector(".logo").innerHTML=
        data.name || "yamennasra";

    toast("تم حفظ إعدادات المتجر");

}

function loadSettings(){

    const data=
        JSON.parse(localStorage.getItem(STORAGE_SETTINGS)||"{}");

    if(data.name){

        document.getElementById("storeName").value=data.name;

        document.querySelector(".logo").innerHTML=
            data.name;

    }

    if(data.description){

        document.getElementById("storeDescription").value=
            data.description;

    }

}


/* =========================================================
   RESET
========================================================= */

function resetEverything(){

    if(!confirm(
        "تحذير: سيتم حذف المنتجات والطلبات والسلة والإعدادات. هل أنت متأكد؟"
    )){
        return;
    }

    localStorage.removeItem(STORAGE_PRODUCTS);
    localStorage.removeItem(STORAGE_CART);
    localStorage.removeItem(STORAGE_ORDERS);
    localStorage.removeItem(STORAGE_DELIVERY);
    localStorage.removeItem(STORAGE_SETTINGS);

    location.reload();

}


