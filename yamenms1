/* =========================================================
   GENERATE 150 PRODUCTS
========================================================= */

function generateProducts(){

    const saved = localStorage.getItem(STORAGE_PRODUCTS);

    if(saved){
        return JSON.parse(saved);
    }

    let products=[];
    let id=1;

    categories.slice(1).forEach(category=>{

        const names=productNames[category];

        names.forEach((name,index)=>{

            const product={
                id:id,
                name:name+" "+(index+1),
                category:category,
                price:Math.floor(59+(index*17)+(id%7)*9),
                stock:Math.floor(5+(id*3)%46),
                colors:[
                    index%2===0 ? "#111111" : "#c9a227",
                    index%3===0 ? "#c0c0c0" : "#6b4423"
                ],
                image:imagePool[(id-1)%imagePool.length],
                description:
                    "إكسسوار رجالي أنيق من مجموعة yamennasra. " +
                    "تصميم عصري مناسب للاستخدام اليومي والمناسبات. " +
                    "متوفر بلونين مختارين بعناية.",
                barcode:"629"+String(100000000+id).slice(-9)
            };

            products.push(product);
            id++;

        });

    });

    /* 10 categories × 10 = 100
       نكرر المجموعات لإكمال 150 */

    while(products.length<150){

        const source=products[products.length%100];

        const copy={
            ...source,
            id:id,
            name:source.name+" إصدار "+(Math.floor(id/100)+1),
            price:source.price+((id%5)*10),
            stock:Math.floor(5+(id*7)%50),
            barcode:"629"+String(100000000+id).slice(-9),
            image:imagePool[(id-1)%imagePool.length]
        };

        products.push(copy);
        id++;

    }

    localStorage.setItem(STORAGE_PRODUCTS,JSON.stringify(products));

    return products;
}

