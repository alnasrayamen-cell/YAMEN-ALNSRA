<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#6d28d9">
<title>yamennasra | إكسسوارات رجالية</title>

<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --purple:#6d28d9;
    --purple2:#8b5cf6;
    --purple3:#ede9fe;
    --dark:#17121f;
    --gray:#6b7280;
    --light:#f8f7fc;
    --white:#fff;
    --danger:#dc2626;
    --success:#16a34a;
    --border:#e5e7eb;
    --shadow:0 10px 35px rgba(40,20,80,.08);
}

body{
    font-family:Arial,"Tahoma",sans-serif;
    background:var(--light);
    color:var(--dark);
}

button,input,select,textarea{
    font-family:inherit;
}

button{
    cursor:pointer;
}

a{
    text-decoration:none;
    color:inherit;
}

/* HEADER */

header{
    background:#fff;
    border-bottom:1px solid var(--border);
    position:sticky;
    top:0;
    z-index:1000;
}

.nav{
    max-width:1400px;
    margin:auto;
    min-height:75px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    padding:12px 20px;
}

.logo{
    font-size:25px;
    font-weight:900;
    color:var(--purple);
    letter-spacing:-1px;
}

.logo span{
    color:#111;
}

.search{
    flex:1;
    max-width:550px;
    position:relative;
}

.search input{
    width:100%;
    height:45px;
    border:1px solid var(--border);
    border-radius:14px;
    padding:0 45px 0 15px;
    outline:none;
    font-size:15px;
    background:#fafafa;
}

.search input:focus{
    border-color:var(--purple2);
    box-shadow:0 0 0 3px var(--purple3);
}

.search-icon{
    position:absolute;
    right:15px;
    top:13px;
}

.header-actions{
    display:flex;
    align-items:center;
    gap:9px;
}

.icon-btn{
    width:44px;
    height:44px;
    border:1px solid var(--border);
    background:#fff;
    border-radius:13px;
    font-size:19px;
    position:relative;
}

.icon-btn:hover{
    border-color:var(--purple2);
    color:var(--purple);
}

.cart-count{
    position:absolute;
    top:-5px;
    left:-5px;
    width:20px;
    height:20px;
    border-radius:50%;
    background:var(--purple);
    color:white;
    font-size:11px;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* HERO */

.hero{
    max-width:1400px;
    margin:25px auto 10px;
    padding:0 20px;
}

.hero-box{
    min-height:280px;
    border-radius:28px;
    overflow:hidden;
    background:linear-gradient(135deg,#4c1d95,#7c3aed,#a78bfa);
    color:white;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:45px;
    position:relative;
}

.hero-box:after{
    content:"";
    position:absolute;
    width:400px;
    height:400px;
    border-radius:50%;
    background:rgba(255,255,255,.1);
    left:-100px;
    bottom:-200px;
}

.hero-text{
    position:relative;
    z-index:2;
    max-width:650px;
}

.hero-text h1{
    font-size:44px;
    margin-bottom:15px;
}

.hero-text p{
    font-size:18px;
    line-height:1.8;
    opacity:.95;
}

.hero-button{
    display:inline-block;
    margin-top:22px;
    background:white;
    color:var(--purple);
    padding:13px 24px;
    border-radius:12px;
    font-weight:bold;
}

/* CATEGORIES */

.categories{
    max-width:1400px;
    margin:20px auto;
    padding:0 20px;
    display:flex;
    gap:10px;
    overflow:auto;
}

.category{
    border:1px solid var(--border);
    background:white;
    padding:11px 18px;
    border-radius:12px;
    white-space:nowrap;
}

.category.active,
.category:hover{
    background:var(--purple);
    color:white;
    border-color:var(--purple);
}

/* PRODUCTS */

.container{
    max-width:1400px;
    margin:auto;
    padding:15px 20px 60px;
}

.section-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:25px 0;
}

.section-head h2{
    font-size:25px;
}

.product-count{
    color:var(--gray);
}

.products{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:18px;
}

.card{
    background:white;
    border:1px solid var(--border);
    border-radius:18px;
    overflow:hidden;
    transition:.25s;
    box-shadow:0 4px 15px rgba(0,0,0,.02);
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:var(--shadow);
}

.product-img{
    width:100%;
    aspect-ratio:1/1;
    object-fit:cover;
    background:#f3f3f3;
}

.card-body{
    padding:14px;
}

.product-category{
    color:var(--purple);
    font-size:12px;
    font-weight:bold;
    margin-bottom:7px;
}

.product-name{
    font-size:16px;
    font-weight:bold;
    min-height:40px;
}

.product-info{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-top:12px;
}

.price{
    font-size:18px;
    font-weight:900;
    color:var(--purple);
}

.stock{
    font-size:12px;
    color:var(--success);
}

.stock.out{
    color:var(--danger);
}

.colors{
    display:flex;
    gap:6px;
    margin-top:11px;
}

.color{
    width:20px;
    height:20px;
    border-radius:50%;
    border:2px solid white;
    outline:1px solid #ccc;
}

.card button{
    width:100%;
    border:0;
    background:var(--purple);
    color:white;
    padding:11px;
    border-radius:10px;
    margin-top:13px;
    font-weight:bold;
}

.card button:hover{
    background:#5b21b6;
}

.card button:disabled{
    background:#aaa;
    cursor:not-allowed;
}

/* DRAWER */

.overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.5);
    z-index:1999;
}

.overlay.show{
    display:block;
}

.drawer{
    position:fixed;
    top:0;
    right:-450px;
    width:430px;
    max-width:95%;
    height:100vh;
    background:white;
    z-index:2000;
    transition:.3s;
    display:flex;
    flex-direction:column;
}

.drawer.show{
    right:0;
}

.drawer-header{
    padding:20px;
    border-bottom:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.drawer-header h2{
    color:var(--purple);
}

.close{
    width:38px;
    height:38px;
    border:0;
    background:#f3f4f6;
    border-radius:10px;
    font-size:20px;
}

.cart-items{
    flex:1;
    overflow:auto;
    padding:15px;
}

.cart-item{
    display:flex;
    gap:12px;
    padding:12px 0;
    border-bottom:1px solid var(--border);
}

.cart-item img{
    width:75px;
    height:75px;
    object-fit:cover;
    border-radius:12px;
}

.cart-details{
    flex:1;
}

.cart-details h4{
    margin-bottom:6px;
}

.qty{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:8px;
}

.qty button{
    width:27px;
    height:27px;
    border:1px solid var(--border);
    background:white;
    border-radius:7px;
}

.drawer-footer{
    padding:18px;
    border-top:1px solid var(--border);
}

.total{
    display:flex;
    justify-content:space-between;
    font-size:20px;
    font-weight:bold;
    margin-bottom:15px;
}

.primary{
    width:100%;
    border:0;
    background:var(--purple);
    color:white;
    padding:14px;
    border-radius:12px;
    font-weight:bold;
}

.secondary{
    border:1px solid var(--border);
    background:white;
    padding:12px 16px;
    border-radius:10px;
}

/* MODAL */

.modal{
    display:none;
    position:fixed;
    inset:0;
    z-index:3000;
    background:rgba(0,0,0,.55);
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:650px;
    max-width:100%;
    max-height:92vh;
    overflow:auto;
    background:white;
    border-radius:20px;
    padding:25px;
}

.modal-head{
    display:flex;
    justify-content:space-between;
    margin-bottom:20px;
}

/* CHECKOUT */

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;
    margin-bottom:7px;
    font-weight:bold;
}

.form-group input,
.form-group select,
.form-group textarea{
    width:100%;
    padding:12px;
    border:1px solid var(--border);
    border-radius:10px;
    outline:none;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{
    border-color:var(--purple);
}

.row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

/* ADMIN */

.admin{
    display:none;
    position:fixed;
    inset:0;
    background:#f6f5fa;
    z-index:5000;
    overflow:auto;
}

.admin.show{
    display:block;
}

.admin-top{
    height:70px;
    background:#17121f;
    color:white;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 25px;
}

.admin-logo{
    font-size:22px;
    font-weight:bold;
}

.admin-layout{
    display:flex;
    min-height:calc(100vh - 70px);
}

.admin-side{
    width:230px;
    background:white;
    border-left:1px solid var(--border);
    padding:18px;
}

.admin-menu button{
    width:100%;
    border:0;
    background:white;
    text-align:right;
    padding:13px;
    border-radius:10px;
    margin-bottom:6px;
}

.admin-menu button:hover,
.admin-menu button.active{
    background:var(--purple3);
    color:var(--purple);
}

.admin-main{
    flex:1;
    padding:25px;
    min-width:0;
}

.dashboard{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:25px;
}

.stat{
    background:white;
    border-radius:15px;
    padding:20px;
    border:1px solid var(--border);
}

.stat small{
    color:var(--gray);
}

.stat strong{
    display:block;
    font-size:27px;
    margin-top:8px;
    color:var(--purple);
}

.admin-section{
    display:none;
}

.admin-section.active{
    display:block;
}

.admin-card{
    background:white;
    border:1px solid var(--border);
    border-radius:16px;
    padding:20px;
    margin-bottom:20px;
}

.admin-card h2{
    margin-bottom:18px;
}

.table-wrap{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:750px;
}

th,td{
    padding:12px;
    border-bottom:1px solid var(--border);
    text-align:right;
}

th{
    background:#fafafa;
}

.small-btn{
    border:0;
    padding:7px 10px;
    border-radius:8px;
    margin:2px;
}

.edit{
    background:#ede9fe;
    color:#5b21b6;
}

.delete{
    background:#fee2e2;
    color:#b91c1c;
}

.barcode-box{
    background:white;
    padding:20px;
    border-radius:15px;
    text-align:center;
}

.barcode-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
    margin-top:20px;
}

.barcode-label{
    border:1px dashed #aaa;
    padding:15px;
    background:white;
}

.barcode-label strong{
    display:block;
    margin-bottom:8px;
}

.delivery-status{
    background:#f0fdf4;
    color:#166534;
    padding:12px;
    border-radius:10px;
    margin-bottom:15px;
}

/* TOAST */

.toast{
    position:fixed;
    bottom:25px;
    left:25px;
    background:#17121f;
    color:white;
    padding:13px 18px;
    border-radius:12px;
    z-index:9000;
    transform:translateY(100px);
    opacity:0;
    transition:.3s;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

/* FOOTER */

footer{
    background:#17121f;
    color:white;
    text-align:center;
    padding:35px 20px;
}

footer .footer-logo{
    color:#a78bfa;
    font-size:24px;
    font-weight:bold;
    margin-bottom:8px;
}

/* MOBILE */

@media(max-width:1100px){
    .products{
        grid-template-columns:repeat(4,1fr);
    }
}

@media(max-width:800px){
    .nav{
        flex-wrap:wrap;
    }

    .search{
        order:3;
        flex-basis:100%;
        max-width:none;
    }

    .hero-box{
        padding:30px;
        min-height:240px;
    }

    .hero-text h1{
        font-size:32px;
    }

    .products{
        grid-template-columns:repeat(3,1fr);
    }

    .dashboard{
        grid-template-columns:repeat(2,1fr);
    }

    .admin-side{
        width:75px;
        padding:10px;
    }

    .admin-menu button{
        font-size:0;
        text-align:center;
    }

    .admin-menu button:first-letter{
        font-size:20px;
    }

    .barcode-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:550px){
    .logo{
        font-size:20px;
    }

    .hero{
        margin-top:12px;
    }

    .hero-box{
        padding:25px;
        border-radius:20px;
    }

    .hero-text h1{
        font-size:27px;
    }

    .hero-text p{
        font-size:14px;
    }

    .products{
        grid-template-columns:repeat(2,1fr);
        gap:10px;
    }

    .card-body{
        padding:10px;
    }

    .product-name{
        font-size:14px;
    }

    .price{
        font-size:16px;
    }

    .drawer{
        width:100%;
        max-width:100%;
    }

    .row{
        grid-template-columns:1fr;
    }

    .dashboard{
        grid-template-columns:1fr 1fr;
    }

    .admin-main{
        padding:12px;
    }

    .barcode-grid{
        grid-template-columns:1fr;
    }
}

/* PRINT */

@media print{
    body *{
        visibility:hidden;
    }

    #barcodePrintArea,
    #barcodePrintArea *{
        visibility:visible;
    }

    #barcodePrintArea{
        position:absolute;
        top:0;
        right:0;
        width:100%;
    }

    .barcode-grid{
        grid-template-columns:repeat(3,1fr);
    }
}
</style>
</head>

<body>

<header>
    <div class="nav">
        <div class="logo">yamen<span>nasra</span></div>

        <div class="search">
            <span class="search-icon">🔍</span>
            <input id="searchInput" type="text" placeholder="ابحث عن ساعة، محفظة، سوار...">
        </div>

        <div class="header-actions">
            <button class="icon-btn" onclick="openAdmin()" title="لوحة الإدارة">⚙️</button>

            <button class="icon-btn" onclick="openCart()" title="السلة">
                🛒
                <span class="cart-count" id="cartCount">0</span>
            </button>
        </div>
    </div>
</header>

<section class="hero">
    <div class="hero-box">
        <div class="hero-text">
            <h1>أناقتك تبدأ من التفاصيل</h1>
            <p>
                اكتشف مجموعة yamennasra من الإكسسوارات الرجالية
                المختارة بعناية لتكمل إطلالتك.
            </p>
            <a href="#products" class="hero-button">تسوق الآن</a>
        </div>
    </div>
</section>

<div class="categories" id="categories"></div>

<main class="container" id="products">
    <div class="section-head">
        <h2>منتجاتنا</h2>
        <span class="product-count" id="productCount"></span>
    </div>

    <div class="products" id="productGrid"></div>
</main>

<footer>
    <div class="footer-logo">yamennasra</div>
    <p>إكسسوارات رجالية • أناقة • جودة • ثقة</p>
    <p style="margin-top:12px;color:#aaa;">©️ 2026 yamennasra</p>
</footer>


<!-- CART -->

<div class="overlay" id="overlay" onclick="closeAll()"></div>

<div class="drawer" id="cartDrawer">
    <div class="drawer-header">
        <h2>🛒 سلة المشتريات</h2>
        <button class="close" onclick="closeCart()">×</button>
    </div>

    <div class="cart-items" id="cartItems"></div>

    <div class="drawer-footer">
        <div class="total">
            <span>المجموع</span>
            <span id="cartTotal">0 ₪</span>
        </div>

        <button class="primary" onclick="openCheckout()">
            إتمام الطلب
        </button>
    </div>
</div>


<!-- CHECKOUT -->

<div class="modal" id="checkoutModal">
    <div class="modal-box">
        <div class="modal-head">
            <h2>إتمام الطلب</h2>
            <button class="close" onclick="closeCheckout()">×</button>
        </div>

        <div class="form-group">
            <label>الاسم الكامل</label>
            <input id="customerName" placeholder="اكتب اسمك">
        </div>

        <div class="row">
            <div class="form-group">
                <label>رقم الهاتف</label>
                <input id="customerPhone" placeholder="05xxxxxxxx">
            </div>

            <div class="form-group">
                <label>المدينة</label>
                <input id="customerCity" placeholder="جنين، نابلس...">
            </div>
        </div>

        <div class="form-group">
            <label>العنوان بالتفصيل</label>
            <textarea id="customerAddress" rows="3" placeholder="الحي، الشارع، رقم المنزل..."></textarea>
        </div>

        <div class="form-group">
            <label>طريقة الدفع</label>
            <select id="paymentMethod">
                <option>الدفع عند الاستلام</option>
                <option>تحويل بنكي</option>
                <option>دفع إلكتروني</option>
            </select>
        </div>

        <button class="primary" onclick="placeOrder()">
            تأكيد الطلب
        </button>
    </div>
</div>


<!-- ADMIN -->

<div class="admin" id="adminPanel">

    <div class="admin-top">
        <div class="admin-logo">yamennasra | لوحة الإدارة</div>

        <button class="secondary" onclick="closeAdmin()">
            العودة للمتجر
        </button>
    </div>

    <div class="admin-layout">

        <aside class="admin-side">
            <div class="admin-menu">

                <button class="active" onclick="showAdminSection('dashboard',this)">
                    📊 الرئيسية
                </button>

                <button onclick="showAdminSection('productsAdmin',this)">
                    📦 المنتجات
                </button>

                <button onclick="showAdminSection('addProduct',this)">
                    ➕ إضافة منتج
                </button>

                <button onclick="showAdminSection('stock',this)">
                    🏷️ المخزون
                </button>

                <button onclick="showAdminSection('barcodes',this)">
                    🖨️ الباركود
                </button>

                <button onclick="showAdminSection('orders',this)">
                    🛒 الطلبات
                </button>

                <button onclick="showAdminSection('delivery',this)">
                    🚚 التوصيل
                </button>

                <button onclick="showAdminSection('settings',this)">
                    ⚙️ الإعدادات
                </button>

            </div>
        </aside>

        <main class="admin-main">

            <!-- DASHBOARD -->

            <section class="admin-section active" id="dashboard">

                <div class="dashboard">

                    <div class="stat">
                        <small>إجمالي المنتجات</small>
                        <strong id="statProducts">0</strong>
                    </div>

                    <div class="stat">
                        <small>المخزون الكلي</small>
                        <strong id="statStock">0</strong>
                    </div>

                    <div class="stat">
                        <small>عدد الطلبات</small>
                        <strong id="statOrders">0</strong>
                    </div>

                    <div class="stat">
                        <small>قيمة المبيعات</small>
                        <strong id="statSales">0 ₪</strong>
                    </div>

                </div>

                <div class="admin-card">
                    <h2>مرحباً بك في لوحة yamennasra 👋</h2>
                    <p>
                        من هنا تستطيع التحكم بالمنتجات والأسعار والمخزون
                        والصور والباركود والطلبات وإعدادات التوصيل.
                    </p>
                </div>

                <div class="admin-card">
                    <h2>تنبيه المخزون</h2>
                    <div id="lowStock"></div>
                </div>

            </section>


            <!-- PRODUCTS ADMIN -->

            <section class="admin-section" id="productsAdmin">

                <div class="admin-card">

                    <div class="section-head">
                        <h2>إدارة المنتجات</h2>
                        <button class="primary" style="width:auto" onclick="showAdminSectionById('addProduct')">
                            + إضافة منتج
                        </button>
                    </div>

                    <div class="table-wrap">
                        <table>
