function addToCart(id){

    const product=products.find(p=>p.id===id);

    if(!product || product.stock<=0){
        toast("المنتج غير متوفر");
        return;
    }

    const existing=cart.find(i=>i.id===id);

    if(existing){

        if(existing.qty>=product.stock){
            toast("لا توجد كمية إضافية في المخزون");
            return;
        }

        existing.qty++;

    }else{

        cart.push({
            id:id,
            qty:1
        });

    }

    saveCart();
    renderCart();
    toast("تمت إضافة المنتج للسلة 🛒");
}

function changeQty(id,delta){

    const item=cart.find(i=>i.id===id);

    const product=products.find(p=>p.id===id);

    if(!item || !product) return;

    item.qty+=delta;

    if(item.qty<=0){

        cart=cart.filter(i=>i.id!==id);

    }else if(item.qty>product.stock){

        item.qty=product.stock;

        toast("وصلت للكمية المتوفرة");

    }

    saveCart();
    renderCart();
}

function cartTotal(){

    return cart.reduce((sum,item)=>{

        const p=products.find(x=>x.id===item.id);

        return sum+(p ? p.price*item.qty : 0);

    },0);

}

function renderCart(){

    document.getElementById("cartCount").textContent=
        cart.reduce((s,i)=>s+i.qty,0);

    const box=document.getElementById("cartItems");

    if(cart.length===0){

        box.innerHTML=`
            <div style="text-align:center;padding:60px 10px;">
                <div style="font-size:50px;">🛒</div>
                <h3 style="margin-top:15px;">السلة فارغة</h3>
                <p style="color:#777;margin-top:8px;">
                    أضف بعض المنتجات لتبدأ التسوق.
                </p>
            </div>
        `;

    }else{

        box.innerHTML=cart.map(item=>{

            const p=products.find(x=>x.id===item.id);

            if(!p) return "";

            return `

            <div class="cart-item">

                <img src="${p.image}" alt="${p.name}">

                <div class="cart-details">

                    <h4>${p.name}</h4>

                    <div style="color:#6d28d9;font-weight:bold;">
                        ${money(p.price)}
                    </div>

                    <div class="qty">

                        <button onclick="changeQty(${p.id},-1)">−</button>

                        <strong>${item.qty}</strong>

                        <button onclick="changeQty(${p.id},1)">+</button>

                    </div>

                </div>

            </div>

            `;

        }).join("");

    }

    document.getElementById("cartTotal").textContent=
        money(cartTotal());
}

