        return;
    }

    const orderId=
        "YN-"+Date.now().toString().slice(-8);

    const items=cart.map(item=>{

        const p=products.find(x=>x.id===item.id);

        return {
            id:p.id,
            name:p.name,
            price:p.price,
            qty:item.qty
        };

    });

    const order={
        id:orderId,
        customer:name,
        phone:phone,
        city:city,
        address:address,
        payment:payment,
        items:items,
        total:cartTotal(),
        date:new Date().toLocaleString("ar"),
        status:"جديد"
    };

    /* خصم المخزون */

    cart.forEach(item=>{

        const p=products.find(x=>x.id===item.id);

        if(p){
            p.stock-=item.qty;

            if(p.stock<0) p.stock=0;
        }

    });

    orders.unshift(order);

    cart=[];

    saveProducts();
    saveOrders();
    saveCart();

    closeCheckout();
    closeCart();

    renderProducts();
    renderCart();
    updateAdmin();

    toast("تم إنشاء الطلب بنجاح 🎉 رقم الطلب: "+orderId);

}


