<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>لوحة تحكم الأدمن</title>

    <link rel="stylesheet"
          href="style.css">
</head>

<body class="admin-body">


    <!-- ================= HEADER ================= -->

    <header class="topbar">

        <div class="brand">
            🔐 لوحة الأدمن
        </div>

        <nav>

            <a href="index.html">
                🛍️ المتجر
            </a>

        </nav>

    </header>



    <!-- ================= ADMIN ================= -->

    <main class="admin">

        <h1>
            لوحة التحكم
        </h1>

        <p class="muted">
            مرحباً بك في لوحة إدارة المتجر.
        </p>



        <!-- ================= STATS ================= -->

        <section class="stats">


            <div class="stat">

                <span>
                    👀 الزوار
                </span>

                <b id="visitors">
                    0
                </b>

            </div>


            <div class="stat">

                <span>
                    🛍️ المنتجات
                </span>

                <b id="productCount">
                    0
                </b>

            </div>


            <div class="stat">

                <span>
                    🛒 السلة
                </span>

                <b id="cartStat">
                    0
                </b>

            </div>


            <div class="stat">

                <span>
                    📦 الطلبات
                </span>

                <b id="orders">
                    0
                </b>

            </div>


        </section>



        <!-- ================= VISITORS ================= -->

        <section class="panel">

            <h2>
                👀 الزوار
            </h2>


            <div class="visitor-box">


                <div>

                    <b id="liveVisitors">
                        0
                    </b>

                    <span>
                        زائر حالياً
                    </span>

                </div>


                <div>

                    <b id="todayVisitors">
                        0
                    </b>

                    <span>
                        زيارات اليوم
                    </span>

                </div>


            </div>


            <p class="muted">

                سيتم تطوير هذا القسم لاحقاً ليعرض
                الزوار الحقيقيين من جميع الأجهزة
                باستخدام قاعدة بيانات وتحليلات.

            </p>

        </section>



        <!-- ================= MEDIA ================= -->

        <section class="panel">

            <h2>
                🖼️ مكتبة الصور
            </h2>


            <p>
                من هنا تستطيع رفع صور للمتجر.
            </p>


            <input
                type="file"
                id="imageUpload"
                accept="image/*"
                multiple
            >


            <div
                id="mediaGrid"
                class="media-grid"
            >

            </div>

        </section>



        <!-- ================= HOMEPAGE ================= -->

        <section class="panel">

            <h2>
                🏠 تعديل الصفحة الرئيسية
            </h2>


            <label>
                عنوان البانر
            </label>

            <input
                id="heroTitleInput"
                class="full"
                type="text"
                placeholder="مثلاً: اكتشف منتجاتنا"
            >


            <label>
                وصف البانر
            </label>

            <textarea
                id="heroTextInput"
                class="full"
                rows="4"
                placeholder="اكتب وصف العرض هنا..."
            ></textarea>


            <label>
                رابط صورة البانر
            </label>

            <input
                id="heroImageInput"
                class="full"
                type="text"
                placeholder="https://..."
            >


            <button
                class="btn"
                onclick="saveHero()"
            >
                💾 حفظ التعديلات
            </button>

        </section>



        <!-- ================= ADD PRODUCT ================= -->

        <section class="panel">

            <h2>
                ➕ إضافة منتج
            </h2>


            <div class="form-grid">


                <input
                    id="pName"
                    type="text"
                    placeholder="اسم المنتج"
                >


                <input
                    id="pPrice"
                    type="number"
                    placeholder="السعر"
                >


                <input
                    id="pCategory"
                    type="text"
                    placeholder="التصنيف"
                >


                <input
                    id="pImage"
                    type="text"
                    placeholder="رابط صورة المنتج"
                >


            </div>


            <textarea
                id="pDesc"
                class="full"
                rows="4"
                placeholder="وصف المنتج"
            ></textarea>


            <button
                class="btn"
                onclick="addProduct()"
            >
                ➕ إضافة المنتج
            </button>

        </section>



        <!-- ================= PRODUCTS ================= -->

        <section class="panel">

            <h2>
                🛍️ المنتجات الموجودة
            </h2>


            <div id="adminProducts">

            </div>

        </section>



        <!-- ================= QUICK LINKS ================= -->

        <section class="panel">

            <h2>
                ⚡ اختصارات
            </h2>


            <a
                href="index.html"
                class="btn"
            >
                🛍️ فتح المتجر
            </a>


            <button
                class="btn"
                onclick="location.reload()"
            >
                🔄 تحديث لوحة التحكم
            </button>

        </section>


    </main>



    <!-- ================= JAVASCRIPT ================= -->

    <script src="admin.js"></script>

</body>

</html>
